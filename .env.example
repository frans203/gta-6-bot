# Copie para .env e ajuste. Todas as opções estão em backend/app/config.py (prefixo JASON_).
# Pasta dos vídeos pesados (VODs, cortes, modelos do Whisper, perfis de contas novas). Use um disco com espaço.
JASON_MIDIA=E:\jason-midia
# Modelo do Whisper: tiny | base | small | medium | large-v3   (small é bom e leve)
JASON_WHISPER_MODELO=small
# API oficial da Twitch (grátis) para listar clipes: https://dev.twitch.tv/console/apps
JASON_TWITCH_CLIENT_ID=
JASON_TWITCH_CLIENT_SECRET=
